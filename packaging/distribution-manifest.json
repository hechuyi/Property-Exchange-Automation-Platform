{
  "schema_version": 1,
  "name": "PEAP",
  "profile": "runtime-source",
  "platform": "macOS",
  "offline_app": false,
  "bundled_runtimes": false,
  "include": [
    ".python-version",
    ".gitignore",
    "README.md",
    "pyproject.toml",
    "uv.lock",
    "start.sh",
    "config.py",
    "assets/excel_output_schema.json",
    "assets/runtime_config.json",
    "assets/runtime_config.template.json",
    "desktop_backend/requirements.lock.txt",
    "desktop_backend/**",
    "peap/**",
    "peap_core/**",
    "peap_parsers/**",
    "peap_postprocess/**",
    "frontend/*.css",
    "frontend/*.html",
    "frontend/*.js",
    "frontend/package.json",
    "frontend/package-lock.json",
    "frontend/vite.config.js",
    "frontend/public/**",
    "frontend/src/**",
    "frontend/.gitignore",
    "scripts/__init__.py",
    "scripts/_paths.py",
    "scripts/init_runtime_config.py",
    "scripts/bootstrap_desktop_env.sh",
    "scripts/build_offline_app.py",
    "scripts/check_release_gate.py",
    "scripts/cleanup_archive_conflicts.py",
    "scripts/cleanup_duplicate_source_records.py",
    "scripts/cleanup_missing_source_records.py",
    "scripts/cleanup_sse_bad_snapshots.py",
    "scripts/collect_public_resource_deals.py",
    "scripts/collect_public_resource_deal_supplements.py",
    "scripts/live_truth_audit.py",
    "scripts/prepare_submission.py",
    "scripts/prepare_distribution.py",
    "scripts/repair_business_classifications.py",
    "scripts/validate_offline_app.py",
    "scripts/recover_missing_archive_files.py",
    "scripts/refetch_sse_from_cleanup_manifest.py",
    "scripts/ui_interaction_audit.py",
    "scripts/worktree_delivery_guard.py",
    "packaging/distribution-manifest.json",
    "packaging/offline-app.json",
    "packaging/launcher-template/**",
    "packaging/README.md",
    "docs/architecture.md",
    "docs/api.md",
    "docs/storage.md",
    "docs/operations.md",
    "docs/extending.md",
    "docs/release-gate.md"
  ],
  "exclude": [
    ".git/**",
    ".worktrees/**",
    ".venv/**",
    "frontend/node_modules/**",
    "frontend/tests/**",
    "frontend/dist/**",
    "tests/**",
    "plans/**",
    "docs/superpowers/**",
    "PEAP Launcher.app/**",
    "release/**",
    "dist/**",
    "**/dist/**",
    "output/**",
    "**/output/**",
    "logs/**",
    "**/logs/**",
    "cache/**",
    "**/cache/**",
    "data/**",
    "**/data/**",
    "manual/**",
    "**/manual/**",
    "exports/**",
    "**/exports/**",
    "submission/**",
    "**/submission/**",
    ".pytest_cache/**",
    "**/.pytest_cache/**",
    ".ruff_cache/**",
    "**/.ruff_cache/**",
    "**/__pycache__/**",
    "**/*.pyc",
    "**/*.pyo",
    "**/.DS_Store",
    "peap_postprocess/logs/**",
    "peap_postprocess/postprocess_output/**",
    "peap_postprocess/postprocess_audit/**",
    "peap_postprocess/ppe_config/postprocess_audit/**"
  ]
}
